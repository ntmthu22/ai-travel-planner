# Copy to .env and fill in. NEVER commit .env.
# Model API key stays in the backend only. Set a spending cap on the provider dashboard.
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-2.5-flash
MODEL_API_KEY=
MODEL_MONTHLY_SPEND_CAP_USD=
PORT=
# Where dataset.json, weather.json and holidays.json live (see docs/contract/search.md).
DATA_DIR=data/sample
# file: read the forecast from DATA_DIR/weather.json. Empty: live Open-Meteo.
WEATHER_SOURCE=
# Sign-in accounts for the deployment, as id:password pairs. Passwords never go in git.
SEED_USERS=
# NODE_ENV=production turns the development X-User-Id sign-in off.
NODE_ENV=
